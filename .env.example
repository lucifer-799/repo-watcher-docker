# .env.example —— compose 用环境变量示例（复制为 .env 后按需修改；.env 已被 .gitignore 排除）

# 宿主端口（映射到容器内 8080）
HOST_PORT=8080

# 凭据加密密钥（32 字节以上随机串）：用于加密各平台 token / 通知凭据
# 生成示例：head -c 32 /dev/urandom | base64
# 注意：更换该值会导致既有已加密凭据无法解密（需重新填写）
# CONFIG_ENC_KEY=

# JWT 签名密钥（32 字节以上随机串）
# JWT_SECRET=

# 固定为 0：TCP 模式必须关闭网关身份头信任（为 1 时服务会拒绝启动）
TRUST_GATEWAY_HEADERS=0
