# .env.example —— compose 用环境变量示例（复制为 .env 后按需修改；.env 已被 .gitignore 排除）

# 宿主端口（映射到容器内 8080）
HOST_PORT=8080

# 凭据加密密钥（32 字节以上随机串）：用于加密各平台 token / 通知凭据
# 生成示例：head -c 32 /dev/urandom | base64
# 注意：更换该值会导致既有已加密凭据无法解密（需重新填写）
# CONFIG_ENC_KEY=

# JWT 签名密钥（32 字节以上随机串）
# JWT_SECRET=

# 固定为 0：TCP 模式必须关闭网关身份头信任（为 1 时服务会拒绝启动）
TRUST_GATEWAY_HEADERS=0

# 是否信任反向代理提供的客户端 IP 头（x-real-ip / X-Forwarded-For），用于登录失败限流分桶：
#   true  = 部署在 NPM/Caddy/Nginx 之后（代理会覆盖/追加这些头）——推荐
#   false = 端口直接对外、无代理；此时使用 TCP 连接的真实对端地址，伪造这些头无效
# 注意：无反代却设为 true，等于让攻击者用自带头换分桶绕过限流。
TRUST_PROXY_HEADERS=true
